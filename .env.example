# BeautyDoor Production & Local Environment Configuration
# All sensitive production credentials must be set in your hosting dashboard (e.g. Render Web Service Environment).
# Never commit real secrets to GitHub or public repositories.

# --- Node Environment & Port ---
NODE_ENV=production
PORT=10000

# --- Persistent File Storage ---
# Render Persistent Disk mount path for customer and package media uploads
UPLOADS_DIR=/var/data/uploads

# --- PostgreSQL Database (Render Managed PostgreSQL / Neon / Supabase) ---
# Format: postgresql://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@hostname:5432/beautydoor?sslmode=require

# Optional: set to true to ignore self-signed certificates on managed PostgreSQL instances
DATABASE_SSL_NO_VERIFY=true

# --- Authentication & Security ---
# Critical: Random 64-character secret for signing JWT tokens. Required in production.
JWT_SECRET=generate_a_secure_jwt_secret_random_key_here

# Initial Superadmin account provisioning on fresh database initialization
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SetYourStrongAdminPasswordHere2026!
ADMIN_EMAIL=admin@beautydoor.in

# --- Business Owner Notification Routing ---
# Explicit notification address for instant new booking alerts (Operations & Management)
OWNER_NOTIFICATION_EMAIL=hello@beautydoor.in

# --- Email Dispatch Service (Resend API or SMTP) ---
# Option A: Resend REST API (Recommended for transactional deliverability)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B: Standard SMTP Mail Server (Gmail / Zoho / AWS SES / Hostinger)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=appointments@beautydoor.in
# SMTP_PASS=your_app_password_here

# Email Sender Address Configuration
EMAIL_FROM="BeautyDoor Salon" <appointments@beautydoor.in>
EMAIL_FROM_NAME="BeautyDoor Salon"
EMAIL_FROM_ADDRESS=appointments@beautydoor.in

# --- Firebase Phone Authentication (Client Frontend SDK) ---
# Vite exposes environment variables starting with VITE_ to the customer browser.
# Configure these from your Firebase Console (Project Settings > General > Your apps > Web app)
# Also add your production domain (e.g. beautydoor-rclz.onrender.com) to:
# Firebase Console > Authentication > Settings > Authorized domains
# VITE_FIREBASE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
# VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# --- Firebase Admin SDK (Backend Cryptographic Token Verification) ---
# Option A: Full service account JSON string
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Option B: Path to mounted service account JSON file on Render disk
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-service-account.json
# Option C: Individual service account credentials
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Customer Cellular SMS Dispatch Service (India TRAI / DLT) ---
# Supported providers: 'msg91' | 'fast2sms' | 'twilio' | 'console'
# NOTE: In production (NODE_ENV=production), if provider is 'console' or credentials are missing,
# cellular dispatch is safely reported as unconfigured/blocked (fail-closed, never fake success).
SMS_PROVIDER=console

# Provider 1: MSG91 (DLT Flow API)
# MSG91_AUTH_KEY=your_msg91_authkey_here
# MSG91_SENDER_ID=BTYDOR
# MSG91_TEMPLATE_ID=your_dlt_registered_otp_template_id
# MSG91_TEMPLATE_ID_RECEIVED=your_dlt_booking_received_template_id
# MSG91_TEMPLATE_ID_CONFIRMED=your_dlt_booking_confirmed_template_id
# MSG91_TEMPLATE_ID_REJECTED=your_dlt_booking_rejected_template_id
# MSG91_TEMPLATE_ID_CANCELLED=your_dlt_booking_cancelled_template_id

# Provider 2: Fast2SMS (DLT Quick Route)
# FAST2SMS_API_KEY=your_fast2sms_api_key
# FAST2SMS_SENDER_ID=BTYDOR
# FAST2SMS_MESSAGE_ID=your_dlt_otp_message_id
# FAST2SMS_TEMPLATE_ID_RECEIVED=your_dlt_received_message_id
# FAST2SMS_TEMPLATE_ID_CONFIRMED=your_dlt_confirmed_message_id
# FAST2SMS_TEMPLATE_ID_REJECTED=your_dlt_rejected_message_id
# FAST2SMS_TEMPLATE_ID_CANCELLED=your_dlt_cancelled_message_id

# Provider 3: Twilio (Global Cellular Dispatch)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1234567890

# Verification & OTP (Set to 'false' in production for real random OTP generation)
ENABLE_DEV_OTP=false

# --- Payment Gateway (Fail-Closed Default) ---
# In production, defaults to COD-only until explicitly enabled and verified.
ENABLE_RAZORPAY=false
RAZORPAY_ENABLED=false
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx
