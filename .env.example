# BeautyDoor Production & Local Environment Configuration

# --- Node Environment & Port ---
NODE_ENV=production
PORT=10000

# --- PostgreSQL Database (Render / Neon / Supabase) ---
# Format: postgresql://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@hostname:5432/beautydoor?sslmode=require

# Optional: set to true to ignore self-signed certificates on managed PostgreSQL instances
DATABASE_SSL_NO_VERIFY=true

# --- Authentication & Security ---
# Critical: Random 64-character secret for signing JWT tokens. Required in production.
JWT_SECRET=generate_a_secure_jwt_secret_random_key_here

# Initial Superadmin account provisioning on fresh database initialization
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SetYourStrongAdminPasswordHere2026!
ADMIN_EMAIL=admin@beautydoor.in

# --- Customer Cellular OTP & SMS Dispatch Service (India TRAI / DLT) ---
# Supported providers: 'msg91' | 'fast2sms' | 'twilio' | 'console' (default fallback)
SMS_PROVIDER=console

# Provider 1: MSG91 (DLT Flow API)
# MSG91_AUTH_KEY=your_msg91_authkey_here
# MSG91_TEMPLATE_ID=your_dlt_registered_template_id
# MSG91_SENDER_ID=BTYDOR

# Provider 2: Fast2SMS (DLT Quick Route)
# FAST2SMS_API_KEY=your_fast2sms_api_key
# FAST2SMS_SENDER_ID=BTYDOR
# FAST2SMS_MESSAGE_ID=your_dlt_message_id

# Provider 3: Twilio (Global Cellular Dispatch)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1234567890

# Verification & OTP (Set to 'false' in production for real random OTP generation)
ENABLE_DEV_OTP=false

# --- Storage & CDN Configuration ---
# Optional: CDN base URL for serving persistent media assets
# STORAGE_CDN_URL=https://assets.beautydoor.in

# --- Payment Gateway (Optional / Real credentials only) ---
# Set to 'true' only when valid live/test keys and webhook signature secrets are configured
RAZORPAY_ENABLED=false
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx
